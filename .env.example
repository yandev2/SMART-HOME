# Supabase Configuration (Dapatkan dari Project Settings -> API di Dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Opsional: Kunci rahasia server untuk enkripsi API Key Gemini milik user di database
# Jika kosong, sistem otomatis menurunkan kunci enkripsi dari SUPABASE_SERVICE_ROLE_KEY
APP_ENCRYPTION_KEY=ganti-dengan-string-acak-panjang-minimal-32-karakter
